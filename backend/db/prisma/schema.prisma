generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Recipe {
  id          String   @id @default(cuid())
  youtubeUrl  String   @unique
  videoId     String
  videoTitle  String?
  channelName String?
  creatorUsername String?
  creatorUrl  String?
  platform    String?  // "youtube" or "tiktok"
  transcript  String?

  // Parsed recipe
  title        String
  ingredients  String // JSON string: Array of { amount: string, item: string }
  instructions String // JSON string: Array of { step: number, text: string }
  prepTime     String?
  cookTime     String?
  servings     String?

  // Metadata
  createdAt   DateTime @default(now())
  accessCount Int      @default(1)

  @@index([videoId])
  @@index([createdAt])
}

model SavedRecipe {
  id            String   @id @default(cuid())
  recipeId      String?  // Link to cached Recipe if from video
  sourceUrl     String?  // Original video or blog URL
  sourceType    String   // "video" | "blog"
  title         String
  ingredients   String   // JSON string
  instructions  String   // JSON string
  prepTime      String?
  cookTime      String?
  servings      String?
  tags          String?  // JSON array of tag strings
  notes         String?  // JSON array of note objects
  userEdits     String?  // JSON of user overrides
  collectionIds String?  // JSON array of collection IDs
  notionPageId  String?  // Notion page ID (for sync)
  notionSynced  Boolean  @default(false)
  savedAt       DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([savedAt])
}
