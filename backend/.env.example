# Anthropic (for Claude Haiku recipe parsing)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (for Whisper transcription)
OPENAI_API_KEY=sk-...

# Database (PostgreSQL in production, SQLite for local dev)
# For local dev with SQLite: DATABASE_URL=file:./db/prisma/dev.db
DATABASE_URL=postgresql://user:password@localhost:5432/video_to_recipe

# Optional: Frontend URL for CORS (set in production)
# FRONTEND_URL=https://video-to-receta.vercel.app

# Debug mode
DEBUG=true
